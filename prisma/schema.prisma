generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth v5) tables ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  workspaceName String?

  accounts   Account[]
  sessions   Session[]
  projects   Project[]
  apiKeys    ApiKey[]
  skills     Skill[]
  skillLikes SkillLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain ----------

enum AiProvider {
  CLAUDE
  GEMINI
  OPENAI
}

model ApiKey {
  id         String     @id @default(cuid())
  userId     String
  provider   AiProvider
  ciphertext String     @db.Text
  lastFour   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       ChatSession[]
  folders        Folder[]
  designs        Design[]
  skillOverrides ProjectSkillOverride[]

  @@index([userId, updatedAt])
}

model ChatSession {
  id        String   @id @default(cuid())
  projectId String
  title     String   @default("Session 1")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rolling summary of conversation prefix that has been folded out of the
  // live message window. See `src/lib/ai/context-summarizer.ts`.
  rollingSummary String?

  // Cumulative usage stats for the chatbox circle indicator. All updated
  // atomically in the chat route's stream-finish handler. Cost is computed
  // from a static pricing table (see `src/lib/ai/pricing.ts`); auxiliary
  // model calls (titler, summarizer) are intentionally excluded.
  cumulativeInputTokens  Int   @default(0)
  cumulativeOutputTokens Int   @default(0)
  summarizedCount        Int   @default(0)
  totalCostUsd           Float @default(0)

  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages      Message[]
  questionSets  ClarifyingQuestionSet[]
  designPlans   DesignPlan[]

  @@index([projectId, updatedAt])
}

enum DesignPlanStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model DesignPlan {
  id          String           @id @default(cuid())
  sessionId   String
  title       String
  // Array of { id: string; label: string; completed: boolean } in declared order.
  steps       Json
  status      DesignPlanStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, createdAt])
}

enum ClarifyingQuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
}

model ClarifyingQuestionSet {
  id         String                   @id @default(cuid())
  sessionId  String
  questions  Json
  answers    Json?
  status     ClarifyingQuestionStatus @default(OPEN)
  createdAt  DateTime                 @default(now())
  answeredAt DateTime?

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, createdAt])
}

model Message {
  id          String   @id @default(cuid())
  sessionId   String
  role        String
  parts       Json
  attachments Json?
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Folder {
  id        String   @id @default(cuid())
  projectId String
  parentId  String?
  name      String
  createdAt DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  designs  Design[]

  @@index([projectId, parentId])
}

model Design {
  id        String   @id @default(cuid())
  projectId String
  folderId  String?
  name      String   @default("Untitled design")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  files   DesignFile[]

  @@index([projectId, updatedAt])
}

model DesignFile {
  id        String   @id @default(cuid())
  designId  String
  path      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, path])
}

model Skill {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String?
  content          String   @db.Text
  isPublic         Boolean  @default(false)
  appliedByDefault Boolean  @default(true)
  downloads        Int      @default(0)
  likes            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  likedBy   SkillLike[]
  overrides ProjectSkillOverride[]

  @@index([userId, updatedAt])
  @@index([isPublic])
}

model ProjectSkillOverride {
  projectId String
  skillId   String
  applied   Boolean

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([projectId])
}

model SkillLike {
  skillId   String
  userId    String
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([skillId, userId])
  @@index([userId])
}
