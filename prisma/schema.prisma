generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth v5) tables ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  workspaceName String?

  accounts   Account[]
  sessions   Session[]
  projects   Project[]
  apiKeys    ApiKey[]
  skills     Skill[]
  skillLikes SkillLike[]
  skillSaves SkillSave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain ----------

enum AiProvider {
  CLAUDE
  GEMINI
  OPENAI
}

model ApiKey {
  id         String     @id @default(cuid())
  userId     String
  provider   AiProvider
  ciphertext String     @db.Text
  lastFour   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  // Optional auto-expiry. NULL means the key never expires automatically.
  // The chat route checks this on every request and lazy-deletes any row
  // whose expiry has passed, so an expired key becomes immediately
  // unusable even if a periodic cleanup job hasn't run yet.
  expiresAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  // Indexed so the optional cleanup sweep (or future cron job) can find
  // every expired row across the whole table without a full scan.
  @@index([expiresAt])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions       ChatSession[]
  folders        Folder[]
  designs        Design[]
  skillOverrides ProjectSkillOverride[]

  @@index([userId, updatedAt])
}

model ChatSession {
  id        String   @id @default(cuid())
  projectId String
  title     String   @default("Session 1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rolling summary of conversation prefix that has been folded out of the
  // live message window. See `src/lib/ai/context-summarizer.ts`.
  rollingSummary String?

  // Lifetime usage stats. All updated atomically in the chat route's
  // stream-finish handler. Cost is computed from a static pricing table
  // (see `src/lib/ai/pricing.ts`); auxiliary model calls (titler,
  // summarizer) are intentionally excluded.
  //
  // - `cumulativeInputTokens`: gross lifetime input billed across every
  //   step. Kept for analytics/debugging — NOT surfaced in the UI
  //   because it compounds per turn (re-sent history is billed again
  //   each turn, modulo prompt caching).
  // - `cumulativeOutputTokens`: lifetime sum of every assistant token
  //   ever produced. Surfaced as "Output tokens" in the chatbox popover.
  // - `cumulativeFoldedTokens`: cumulative size of messages the rolling
  //   summarizer has folded into the summary across the session lifetime.
  //   Added to `lastInputTokens` to compute the popover's "Input tokens"
  //   line so it never decreases when summarization shrinks the live
  //   prompt — instead it represents what the live prompt WOULD weigh
  //   if summarization had never fired.
  cumulativeInputTokens  Int   @default(0)
  cumulativeOutputTokens Int   @default(0)
  cumulativeFoldedTokens Int   @default(0)
  summarizedCount        Int   @default(0)
  totalCostUsd           Float @default(0)

  // Provider-reported input token count for the most recent completed step.
  // Doubles as the "current context window fill" indicator in the chatbox
  // ring AND as a floor for the summarization trigger (so a model switch
  // to a smaller context window still fires summarization even when the
  // character-based estimate falls short of the new threshold).
  lastInputTokens Int @default(0)

  // Number of leading client UIMessages that have already been folded into
  // `rollingSummary` and MUST NOT be re-sent to the model on subsequent
  // turns. The client has no way to know the server folded its history
  // (the chat UI deliberately keeps showing every message for the user's
  // benefit), so without this field the chat route would blast the full
  // history back at the LLM on every turn AND tack the summary on top —
  // immediately undoing the summarizer's work and ping-ponging the live
  // request between "small (just summarized)" and "huge (full history
  // again)" on alternate turns. Sliced upfront in the chat route before
  // any token-counting or message conversion happens. Incremented after
  // each summarization fires by the count of UIMessages folded that turn.
  foldedMessageCount Int @default(0)

  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages      Message[]
  questionSets  ClarifyingQuestionSet[]
  designPlans   DesignPlan[]

  @@index([projectId, updatedAt])
}

enum DesignPlanStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model DesignPlan {
  id          String           @id @default(cuid())
  sessionId   String
  title       String
  // Array of { id: string; label: string; completed: boolean } in declared order.
  steps       Json
  status      DesignPlanStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, createdAt])
}

enum ClarifyingQuestionStatus {
  OPEN
  ANSWERED
  DISMISSED
}

model ClarifyingQuestionSet {
  id         String                   @id @default(cuid())
  sessionId  String
  questions  Json
  answers    Json?
  status     ClarifyingQuestionStatus @default(OPEN)
  createdAt  DateTime                 @default(now())
  answeredAt DateTime?

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, createdAt])
}

model Message {
  id          String   @id @default(cuid())
  sessionId   String
  role        String
  parts       Json
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Folder {
  id        String   @id @default(cuid())
  projectId String
  parentId  String?
  name      String
  createdAt DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  designs  Design[]

  @@index([projectId, parentId])
}

model Design {
  id        String   @id @default(cuid())
  projectId String
  folderId  String?
  name      String   @default("Untitled design")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  files   DesignFile[]

  @@index([projectId, updatedAt])
}

model DesignFile {
  id        String   @id @default(cuid())
  designId  String
  path      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, path])
}

model Skill {
  id               String   @id @default(cuid())
  userId           String
  name             String
  description      String?
  content          String   @db.Text
  isPublic         Boolean  @default(false)
  appliedByDefault Boolean  @default(true)
  // Denormalized counters that mirror `savedBy` and `likedBy` row counts.
  // Each per-user action is recorded in the SkillSave / SkillLike join table
  // (composite PK on (skillId, userId)) so a user can only ever contribute
  // +1 to either counter — re-saves after a deletion and repeated likes are
  // both no-ops at the counter level.
  saves            Int      @default(0)
  likes            Int      @default(0)
  // When a user adds a public skill to their library we clone it into a new
  // owned Skill row and point this back at the original. Lets us (a) detect
  // "already in your library" on the public detail page, and (b) attribute
  // clones back to their source. Set to NULL when the source is deleted so
  // the user's copy survives.
  originalSkillId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  likedBy        SkillLike[]
  savedBy        SkillSave[]
  overrides      ProjectSkillOverride[]
  originalSkill  Skill?                 @relation("SkillClones", fields: [originalSkillId], references: [id], onDelete: SetNull)
  clones         Skill[]                @relation("SkillClones")

  @@index([userId, updatedAt])
  @@index([isPublic])
  @@index([userId, originalSkillId])
}

model ProjectSkillOverride {
  projectId String
  skillId   String
  applied   Boolean

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([projectId])
}

/// Permanent record that user X liked public skill Y at some point. The
/// composite PK guarantees one row per (skill, user); the `active` flag
/// captures whether the user *currently* considers it liked. Rows are
/// never deleted by app code — toggling personal state flips `active` —
/// so `Skill.likes` (= COUNT of rows) is monotonic per user: liking and
/// unliking and liking again only counts once toward the public counter.
model SkillLike {
  skillId   String
  userId    String
  /// false when the user has un-liked this skill. Counter contribution is
  /// independent of this flag — it's purely a personal display state.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([skillId, userId])
  @@index([userId])
}

/// Permanent record that user X saved public skill Y at some point. Survives
/// deletion of the user's local clone so re-saving the same skill never
/// double-bumps `Skill.saves`. Composite PK on (skillId, userId) makes the
/// "one save per user" rule a database invariant, not just app code.
model SkillSave {
  skillId   String
  userId    String
  createdAt DateTime @default(now())

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([skillId, userId])
  @@index([userId])
}
