# --- Database ---
# When running everything via docker-compose, use db hostname; for host-side dev, use localhost.
DATABASE_URL="postgresql://laude:laude@localhost:5432/laude_design?schema=public"

# --- NextAuth (Auth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# --- API key encryption ---
# 32 random bytes, base64-encoded. Used to encrypt user API keys at rest with
# AES-256-GCM. Generate with: openssl rand -base64 32
# WARNING: rotating this value will invalidate every stored API key.
ENCRYPTION_KEY=""

# --- OAuth providers ---
# Google: https://console.cloud.google.com/apis/credentials  (Authorized redirect URI: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub: https://github.com/settings/developers  (Authorization callback URL: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Upstash Redis (rate limiting) ---
# Create a Redis database at https://console.upstash.com and copy the REST credentials here.
# If both values are unset, rate limiting is disabled (fine for local dev, NOT recommended in production).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Vercel Blob (file uploads) ---
# Create a Blob store in the Vercel dashboard and copy the token here.
# Docs: https://vercel.com/docs/storage/vercel-blob/quickstart
BLOB_READ_WRITE_TOKEN=""
